# GPU stage: sample FoldBench protein-protein targets with OpenDDE.
#
# PROVENANCE: ours. Nothing here is copied from upstream; it exists only to hand
# the cluster an environment. The software it points at:
#   OpenDDE   https://github.com/aurekaresearch/OpenDDE
#   FoldBench https://github.com/BEAM-Labs/FoldBench
#
# The container carries the orchestrator, not the model. OpenDDE itself, its
# virtualenv, its checkpoint and its common assets all live on RIKYU's /data1
# and are reached through the bind mount (the cluster binds /data1/rkp00041).
# Rebuilding a 2.6 GB checkpoint and a CUDA stack into an image would only
# create a second copy that can drift from the one whose sha256 we verified.
#
# NOTE ON CMD -- this is the trap that cost us a run. When the platform builds
# from a committed Dockerfile it executes this CMD verbatim and ignores the
# analysis entry_point, so `CMD ["bash"]` exits 0 having done nothing and is
# reported as a successful run. The CMD below must invoke the work, and every
# knob it needs must reach it through ENV rather than through flags.
FROM python:3.11-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

# kalign is only reached when templates are enabled, which the baseline leaves
# off because that is OpenDDE's shipped default. It is installed anyway so that
# FB_USE_TEMPLATE=true is a flag rather than a rebuild.
RUN apt-get update && apt-get install -y --no-install-recommends \
    git curl kalign \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace
COPY . .

# Where OpenDDE finds checkpoint/opendde.pt and its CCD data. Declared under our
# own name rather than as OPENDDE_ROOT_DIR, and re-exported under that name by
# src/main.py when it launches the sampler: a variable called OPENDDE_ROOT_DIR
# registered on the execution platform silently replaced this image's value and
# pointed a run's model inputs at a personal directory. Setting it from a name
# nothing outside this repository uses puts the value back under this file's
# control, which is where it is readable.
ENV FB_OPENDDE_ROOT_DIR=/data1/rkp00041/plinder_lddt_pli_improvement/model/opendde_data
# make_predictions.sh defers to these, so the plugin script itself stays free of
# absolute paths and remains readable as the FoldBench plugin it is.
ENV OPENDDE_PYTHON=/data1/rkp00041/plinder_lddt_pli_improvement/model/opendde/.venv/bin/python
ENV OPENDDE_CLI=/data1/rkp00041/plinder_lddt_pli_improvement/model/opendde/.venv/bin/opendde
ENV PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
ENV PYTHONPATH=/workspace

# EVERYTHING THE MODEL READS LIVES UNDER A SHARED PATH. No personal directory
# appears on the input side, on purpose and not as a detail: an experiment whose
# inputs sit in one account's home cannot be reproduced from another account, so
# a matching checksum does not rescue it. The one input that is generated rather
# than distributed -- inputs.json, which carries the MSA paths -- is kept in the
# group directory for the same reason.
ENV FB_STAGE=predict \
    FB_FOLDBENCH_DIR=/data1/rkp00041/plinder_lddt_pli_improvement/data/foldbench/FoldBench \
    FB_TARGETS_DIR=/data1/rkp00041/plinder_lddt_pli_improvement/data/foldbench/FoldBench/targets \
    FB_INPUT_JSON_DIR=/data1/rkp00041/plinder_lddt_pli_improvement/data/foldbench/input_json \
    FB_GROUND_TRUTH_DIR=/data1/rkp00041/plinder_lddt_pli_improvement/data/foldbench/ground_truth_20250520 \
    FB_OPENDDE_SRC=/data1/rkp00041/plinder_lddt_pli_improvement/model/opendde \
    FB_INPUT_DIR=/data1/rkp00041/foldbench-ppi-baseline/input/OpenDDE \
    FB_MSA_DIR=/data1/rkp00041/plinder_lddt_pli_improvement/data/foldbench/opendde/msa

# Run products. These may live anywhere, and do not affect whether someone else
# can repeat the run.
ENV FB_PREDICTION_DIR=/data1/rkp00041/rku00122/foldbench-ppi-baseline/outputs/prediction/OpenDDE \
    FB_EVALUATION_DIR=/data1/rkp00041/rku00122/foldbench-ppi-baseline/outputs/evaluation/OpenDDE

# Both the orchestrator and the model run on OpenDDE's own interpreter, which
# already carries pandas, biotite and torch. Installing a second dependency set
# into the image would only give the two stages different library versions.
# Sharding comes from RANK/WORLD_SIZE, which the launcher sets.
CMD ["/data1/rkp00041/plinder_lddt_pli_improvement/model/opendde/.venv/bin/python", "-u", "-m", "src.main"]
